# Thinkube build of the DentalPin backend. Same steps as Dockerfile, on the
# base images the cluster registry mirrors.
ARG CONTAINER_REGISTRY
FROM ${CONTAINER_REGISTRY}/library/python:3.12-slim

# uv resolves from the committed lockfile, same version as Dockerfile.
RUN pip install --no-cache-dir "uv==0.12.9"

WORKDIR /app

# WeasyPrint needs cairo and pango for PDF generation; psql is used by
# docker-entrypoint.sh.
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    postgresql-client \
    libcairo2 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libffi-dev \
    shared-mime-info \
    fonts-noto-core \
    && rm -rf /var/lib/apt/lists/*

# The venv uses the image's own Python; uv must not download another.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON=/usr/local/bin/python3 \
    UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    PATH="/opt/venv/bin:$PATH"
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY . .
RUN uv sync --frozen --no-dev

RUN uv pip install --python /opt/venv/bin/python "pip==26.2.1"

RUN useradd -m -u 1000 appuser \
    && mkdir -p /app/storage \
    && chmod +x /app/docker-entrypoint.sh /app/thinkube-entrypoint.sh \
    && chown -R appuser:appuser /app
USER appuser

ENV ENVIRONMENT=production

EXPOSE 8000

ENTRYPOINT ["/app/thinkube-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
